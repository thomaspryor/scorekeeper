# Release lanes for Scorekeep. Run by .github/workflows/ios-release.yml on a macOS runner;
# nobody needs to run these by hand. Auth is an App Store Connect API key whose path
# comes from ASC_KEY_PATH (written from the ASC_API_KEY_P8 GitHub secret).
default_platform(:ios)

BUNDLE_ID = "co.scorekeep.app"
APP_NAME = "Scorekeep"
INTERNAL_GROUP = "Owner"

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )
  end

  desc "Register the bundle ID and report whether the App Store Connect app record exists"
  lane :preflight do
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if bundle
      UI.message("Bundle ID #{BUNDLE_ID} already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: "IOS", identifier: BUNDLE_ID)
      UI.success("Registered bundle ID #{BUNDLE_ID}")
    end

    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    unless app
      UI.user_error!(
        "No App Store Connect app for #{BUNDLE_ID} yet. Create it once in App Store Connect " \
        "(My Apps > + > New App, bundle ID #{BUNDLE_ID}); see memory/app-store.md."
      )
    end
    UI.success("App Store Connect app: #{app.name} (#{app.id})")
  end

  desc "Put the account's admins in an internal TestFlight group that gets every build"
  lane :internal_testers do
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    group = app.get_beta_groups(filter: { name: INTERNAL_GROUP }).find(&:is_internal_group)
    unless group
      # Not app.create_beta_group: fastlane 2.241.1 always sends public link
      # fields, which Apple rejects for internal groups ("Public link limit
      # cannot be applied to internal group").
      Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: { name: INTERNAL_GROUP, isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { type: "apps", id: app.id } } }
        }
      })
      group = app.get_beta_groups(filter: { name: INTERNAL_GROUP }).find(&:is_internal_group)
      UI.user_error!("Created group '#{INTERNAL_GROUP}' but could not read it back") unless group
      UI.success("Created internal TestFlight group '#{INTERNAL_GROUP}' with access to all builds")
    end

    already = Spaceship::ConnectAPI::BetaTester.all(filter: { betaGroups: group.id })
                                               .map { |t| t.email.to_s.downcase }
    owners = Spaceship::ConnectAPI::User.all.select do |user|
      ((user.roles || []) & %w[ACCOUNT_HOLDER ADMIN]).any?
    end
    UI.user_error!("No Account Holder or Admin users found in App Store Connect") if owners.empty?

    owners.each do |user|
      # App Store Connect users carry their Apple ID in `username`; `email` is often empty.
      email = [user.email, user.username].map(&:to_s).find { |value| value.include?("@") }
      unless email
        UI.important("Skipping #{user.first_name} #{user.last_name}: no email on the account")
        next
      end
      if already.include?(email.downcase)
        UI.message("#{user.first_name} is already a tester")
        next
      end
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group.id],
        attributes: { email: email, firstName: user.first_name, lastName: user.last_name }
      )
      UI.success("Added #{user.first_name} #{user.last_name} to TestFlight group '#{INTERNAL_GROUP}'")
    end
  end

  desc "Upload an exported .ipa to TestFlight and wait until Apple finishes processing it"
  lane :beta do |options|
    upload_to_testflight(
      ipa: options.fetch(:ipa),
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false
    )
  end

  desc "Push listing text and screenshots; optionally submit the build for App Review"
  lane :listing do |options|
    # App Review refuses a submission until the content rights question is answered.
    # Scorekeep shows no third-party content (players type their own names and scores).
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    unless app.content_rights_declaration
      app.update(attributes: {
        content_rights_declaration: Spaceship::ConnectAPI::App::ContentRightsDeclaration::DOES_NOT_USE_THIRD_PARTY_CONTENT
      })
      UI.success("Answered content rights: no third-party content")
    end

    # The build is attached to the version only when submitting; without
    # submit the version page keeps showing "Add Build".
    deliver(
      app_identifier: BUNDLE_ID,
      app_version: options.fetch(:version),
      build_number: options[:build_number],
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: options[:submit] == true || options[:submit] == "true",
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
